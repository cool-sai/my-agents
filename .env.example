# DeepSeek API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your_key_here

# OpenAI 兼容接口
LLM_BASE_URL=https://api.deepseek.com

# 常用：deepseek-v4-flash / deepseek-v4-pro / deepseek-chat
LLM_MODEL=deepseek-v4-flash

# 证书校验。走 Clash 等 HTTPS 代理且报 CERTIFICATE_VERIFY_FAILED 时改为 false
# 更稳妥的做法：把代理的 CA 证书装进系统/导出 SSL_CERT_FILE
LLM_SSL_VERIFY=true

