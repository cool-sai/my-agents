# 通用配置：选择一组 OpenAI 兼容接口即可
LLM_API_KEY=your_api_key_here

# GLM（智谱开放平台）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash

# DeepSeek 示例：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# 证书校验。走 Clash 等 HTTPS 代理且报 CERTIFICATE_VERIFY_FAILED 时改为 false
# 更稳妥的做法：把代理的 CA 证书装进系统/导出 SSL_CERT_FILE
LLM_SSL_VERIFY=true

# 第 13 课。本机 Docker MySQL，库 stu_agent。密码不要提交。
# MYSQL_URI=mysql://root:password@127.0.0.1:3306/stu_agent
